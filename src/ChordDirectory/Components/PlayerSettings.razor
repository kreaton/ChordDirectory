@inject AudioService Audio

<div class="settings">
    <label class="field">
        <span>Sound</span>
        <select @bind="Audio.InstrumentId">
            @foreach (var instrument in AudioService.Instruments)
            {
                <option value="@instrument.Id">@instrument.Name</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Volume</span>
        <input type="range" min="0.05" max="1" step="0.05"
               @bind="Audio.Volume" @bind:event="oninput" aria-label="Volume" />
    </label>

    <label class="field">
        <span>Arpeggio speed</span>
        <input type="range" min="80" max="500" step="10"
               value="@(580 - Audio.ArpeggioStepMs)"
               @oninput="OnSpeedChanged" aria-label="Arpeggio speed" />
    </label>
</div>

@code {
    // The slider runs slow → fast, but the engine wants the gap between notes (small = fast).
    private void OnSpeedChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) Audio.ArpeggioStepMs = 580 - v;
    }
}
